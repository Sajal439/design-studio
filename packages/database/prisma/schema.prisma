// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─ Core Models ────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  label     String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designs   Design[]

  @@index([type])
}

model Design {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  estimatedCost String?
  roomSize      String?
  style         String?
  images        Json     @default("[]")
  tags          String[]
  
  // Marketing / Showcase fields
  isRealWork    Boolean  @default(false)
  location      String?
  priceRange    String?
  badge         String?
  waText        String?
  isPublished   Boolean  @default(true)
  categoryId    String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

// ─ Estimator Pricing Engine ───────────────────────────────────────────────────

model PriceBookEntry {
  id        String   @id @default(cuid())

  // Structured key — three formats:
  //   "sheet.BUDGET.plywood"    → SHEET category
  //   "hardware.HINGE_SOFT_CLOSE" → HARDWARE category
  //   "rate.labor"              → RATE category
  key       String   @unique

  category  String   // "SHEET" | "HARDWARE" | "RATE"
  label     String   // "BWR Plywood — budget grade"
  value     Float    // the price or percentage

  // Display help for the admin UI
  unit      String   // "per sqft" | "per piece" | "per set" | "percentage"
  notes     String?

  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

// ─ Consultations ─────────────────────────────────────────────────────────────

model Consultation {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String
  type        String   // e.g. "showroom", "video", "site-visit"
  message     String?
  projectType String?  // e.g. "Modular Kitchen", "Wardrobe", etc.
  location    String?  // customer's city/area
  source      String?  // tracking: "consultation_page", "landing_page", etc.
  status      String   @default("PENDING") // PENDING, CONTACTED, COMPLETED, CANCELLED
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─ Admin Authentication ───────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // "admin", "staff", etc.
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}