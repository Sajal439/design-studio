generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  label     String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designs   Design[]
  products  Product[]
  estimates Estimate[]

  @@index([type])
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String?        @unique
  password      String?
  phone         String         @unique
  role          String         @default("customer")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  quoteRequests QuoteRequest[]
  consultations Consultation[]
}

model Design {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  estimatedCost String
  roomSize      String
  style         String
  images        String[]
  categoryId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category  Category         @relation(fields: [categoryId], references: [id])
  materials DesignMaterial[]
  estimates Estimate[]

  @@index([categoryId])
}

model DesignMaterial {
  id       String @id @default(cuid())
  name     String
  quantity Float
  unit     String
  designId String

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  brand       String
  description String
  priceRange  String
  unit        String
  images      String[]
  inStock     Boolean  @default(true)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category      @relation(fields: [categoryId], references: [id])
  specifications ProductSpec[]

  @@index([categoryId])
}

model ProductSpec {
  id        String @id @default(cuid())
  label     String
  value     String
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model QuoteRequest {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  projectType String
  designSlug  String?
  productSlug String?
  location    String
  message     String?
  status      String   @default("new")
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Consultation {
  id               String   @id @default(cuid())
  name             String
  phone            String
  projectType      String
  location         String
  consultationType String
  status           String   @default("new")
  userId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Estimate {
  id            String   @id @default(uuid())
  categoryId    String
  designId      String
  layout        String
  width         Float
  height        Float
  depth         Float?
  grade         String
  materialsJson String // Stores the calculated detailed bill of materials
  costMin       Int
  costMax       Int
  customerName  String
  customerPhone String
  customerCity  String
  createdAt     DateTime @default(now())

  // Optional relations back to original models
  category Category @relation(fields: [categoryId], references: [id])
  design   Design   @relation(fields: [designId], references: [id])

  @@index([categoryId])
  @@index([designId])
}

model ModuleTemplate {
  id           String   @id @default(cuid())
  type         String   @unique   // "BASE_CABINET", "DRAWER_UNIT", etc.
  label        String             // "Base cabinet"
  category     String             // "kitchen" | "wardrobe" | "tv-unit" | "bedroom" | "study" | "office"
  active       Boolean  @default(true)

  // Dimension bounds (feet)
  widthMin     Float    @default(2.0)
  widthMax     Float    @default(3.5)
  heightDefault Float   @default(2.8)
  depthDefault  Float   @default(2.0)

  // Material area multipliers (× module width × height)
  plywoodMult  Float    @default(1.6)
  finishMult   Float    @default(1.2)
  edgeBandMult Float    @default(20.0)  // linear feet

  // Cabinet structure
  shelves      Int      @default(1)
  doors        Int      @default(2)
  drawers      Int      @default(0)
  shutterMode  String   @default("HINGED")  // "HINGED" | "SLIDING" | "OPEN"

  // Hardware and accessories as JSON maps: { "Soft Close Hinges": 4, "Handles": 2 }
  hardware     Json     @default("{}")
  accessories  Json     @default("{}")

  sortOrder    Int      @default(0)
  notes        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PriceBookEntry {
  id        String   @id @default(cuid())

  // Structured key — three formats:
  //   "sheet.BUDGET.plywood"    → SHEET category
  //   "hardware.HINGE_SOFT_CLOSE" → HARDWARE category
  //   "rate.labor"              → RATE category
  key       String   @unique

  category  String   // "SHEET" | "HARDWARE" | "RATE"
  label     String   // "BWR Plywood — budget grade"
  value     Float    // the price or percentage

  // Display help for the admin UI
  unit      String   // "per sqft" | "per piece" | "per set" | "percentage"
  notes     String?

  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

model ProductMapping {
  id              String   @id @default(cuid())

  // Regex pattern matched against BOM material names (case-insensitive)
  // e.g. "PLYWOOD|MDF", "HINGE", "EDGE"
  pattern         String

  // Ordered list of product slugs to try — first one found in DB wins
  productSlugs    String[] // e.g. ["bwr-plywood-19mm", "marine-plywood-19mm"]

  // Shown on the recommendation card
  reason          String

  // Sort order — lower runs first when multiple patterns could match
  priority        Int      @default(0)

  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}